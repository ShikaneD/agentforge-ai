# Optional. In development, the Vite proxy forwards /api to http://localhost:5151.
# Set this to the API base URL when connecting to a deployed backend.
# VITE_API_BASE_URL=https://localhost:7001

# Configure both values to enable OIDC sign-in in the web client.
# VITE_OIDC_AUTHORITY=https://identity.example.com
# VITE_OIDC_CLIENT_ID=agentforge-web
# VITE_OIDC_SCOPE=openid profile email api://agentforge/access
