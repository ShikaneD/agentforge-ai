# SQL Server local container. Replace this value before starting Compose.
MSSQL_SA_PASSWORD=ReplaceWithAUniqueLongPassword123!

# The deployment must validate access tokens from an OIDC issuer.
AUTHENTICATION_AUTHORITY=https://identity.example.com
AUTHENTICATION_AUDIENCE=api://agentforge
VITE_OIDC_AUTHORITY=https://identity.example.com
VITE_OIDC_CLIENT_ID=agentforge-web
VITE_OIDC_SCOPE=openid profile email api://agentforge/access

# Configure at least one model provider for chat.
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
